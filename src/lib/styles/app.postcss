/* Base Tailwind imports */
@tailwind base;
@tailwind components;
@tailwind utilities;

/* Custom global styles */
@layer base {
	:root {
		--background: 220 20% 97%;
		--foreground: 224 71% 6%;
		--card: 0 0% 100%;
		--card-foreground: 224 71% 6%;
		--popover: 0 0% 100%;
		--popover-foreground: 224 71% 6%;
		--primary: 214 91% 22%;
		--primary-foreground: 210 40% 98%;
		--secondary: 220 16% 93%;
		--secondary-foreground: 224 71% 6%;
		--muted: 220 16% 93%;
		--muted-foreground: 220 10% 46%;
		--accent: 214 91% 96%;
		--accent-foreground: 214 91% 15%;
		--destructive: 0 72% 51%;
		--destructive-foreground: 210 40% 98%;
		--border: 220 16% 88%;
		--input: 220 16% 88%;
		--ring: 214 91% 22%;
		--radius: 0.75rem;
	}

	.dark {
		--background: 228 25% 7%;
		--foreground: 220 16% 93%;
		--card: 228 28% 10%;
		--card-foreground: 220 16% 93%;
		--popover: 228 30% 10%;
		--popover-foreground: 220 16% 93%;
		--primary: 214 91% 22%;
		--primary-foreground: 210 40% 98%;
		--secondary: 225 20% 16%;
		--secondary-foreground: 220 16% 93%;
		--muted: 225 20% 14%;
		--muted-foreground: 220 12% 55%;
		--accent: 225 25% 18%;
		--accent-foreground: 214 91% 60%;
		--destructive: 0 63% 31%;
		--destructive-foreground: 210 40% 98%;
		--border: 225 18% 18%;
		--input: 225 18% 18%;
		--ring: 214 91% 22%;
	}
}

@layer base {
	* {
		@apply border-border;
	}
	body {
		@apply bg-background text-foreground antialiased;
		font-feature-settings:
			'rlig' 1,
			'calt' 1;
	}
}

/* DFIR-IRIS specific styles */
.iris-scrollbar {
	@apply scrollbar-thin scrollbar-thumb-gray-400 dark:scrollbar-thumb-gray-600 scrollbar-track-transparent;
}

.iris-card {
	@apply shadow-elevation-2 overflow-hidden rounded-xl border border-border/60;
}
